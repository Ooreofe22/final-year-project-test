SPRING_PROFILE=dev
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
ADMIN_API_KEY=replace_with_your_admin_key
WALLET_SIGNUP_BONUS=50000
OFFLINE_WALLET_LIMIT=20000
OFFLINE_CERT_VALIDITY_DAYS=7

# prod profile only
PGHOST=localhost
PGPORT=5432
PGDATABASE=offlinepay
PGUSER=postgres
PGPASSWORD=your_password
RESEND_API_KEY=
RESEND_FROM=OfflinePay <auth@yourdomain.com>
